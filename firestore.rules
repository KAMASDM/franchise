// Firestore Security Rules — Production
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function currentViews() {
      return resource.data.views == null ? 0 : resource.data.views;
    }

    function isBlogViewIncrement() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly(['views'])
        && request.resource.data.views == currentViews() + 1;
    }

    // Anonymous view counter (BrandCard/BrandListItem): only the expected
    // fields, the doc id matches its brand, the owner id is the brand's real
    // owner, and every write bumps totalViews by exactly one.
    function isValidBrandView(brandId) {
      let data = request.resource.data;
      let allowed = ['brandId', 'brandOwnerId', 'totalViews', 'lastUpdated',
                     'viewedAt', 'userId', 'sessionId'];
      let previous = resource == null ? 0 : resource.data.get('totalViews', 0);
      return data.keys().hasOnly(allowed)
        && data.brandId == brandId
        && data.brandOwnerId == get(/databases/$(database)/documents/brands/$(brandId)).data.userId
        && data.totalViews == previous + 1;
    }

    // Validate contact/lead form submissions — limit size to prevent flooding
    function isValidPublicSubmission() {
      return request.resource.data.size() <= 30;
    }

    // Franchise inquiries notify brandOwnerId by email (onInquiryCreated
    // function), so it must be the real owner of the brand being inquired
    // about — otherwise anyone could make us email arbitrary users.
    function isValidInquiry() {
      let data = request.resource.data;
      return isValidPublicSubmission()
        && data.status == 'New'
        && data.brandOwnerId == get(/databases/$(database)/documents/brands/$(data.brandId)).data.userId;
    }

    // --- Collection Rules ---

    match /admins/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      // Admins can grant/revoke admin role (User Management promote/demote).
      // Updates are pointless (the doc's existence is the flag) — keep denied.
      allow create, delete: if isAdmin();
      allow update: if false;
    }

    // Immutable admin audit trail: admins can append and read, nobody can
    // edit or delete — history stays trustworthy.
    match /auditLogs/{logId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /users/{userId} {
      allow get: if request.auth.uid == userId || isAdmin();
      allow list: if isAdmin();
      allow create, update: if request.auth.uid == userId || isAdmin();
    }

    match /users/{userId}/notifications/{notificationId} {
      allow read, write: if request.auth.uid == userId || isAdmin();
      // Allow authenticated users to create notifications for other users (e.g. brand submission alerts)
      allow create: if isSignedIn();
    }

    // `read` covers get AND list, so queries must be constrained to what the
    // caller may see: where('status','==','active') for the public,
    // where('userId','==',uid) for owners; only admins may query unfiltered.
    match /brands/{brandId} {
      allow read: if resource.data.status == 'active' || isAdmin()
        || (isSignedIn() && request.auth.uid == resource.data.userId);
      // New listings always start in the admin review queue
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.userId
        && request.resource.data.status == 'pending';
      // Owners may edit their listing but not approve it or hand it to
      // someone else; the only status change they can make is back to pending.
      allow update: if isAdmin() || (isSignedIn()
        && request.auth.uid == resource.data.userId
        && request.resource.data.userId == resource.data.userId
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
            || request.resource.data.status == 'pending'));
      allow delete: if isAdmin();
    }

    // Leads carry investor PII — only the brand's owner and admins may read.
    // Owner queries must filter where('brandOwnerId','==',uid).
    match /brandfranchiseInquiry/{inquiryId} {
      allow create: if isValidInquiry();
      allow read: if isSignedIn() && (request.auth.uid == resource.data.brandOwnerId || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /brandViews/{brandId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.brandOwnerId || isAdmin());
      allow create, update: if isValidBrandView(brandId);
      allow delete: if isAdmin();
    }

    match /contactUs/{contactId} {
      allow create: if isValidPublicSubmission();
      allow read, update, delete: if isAdmin();
    }

    match /chatLeads/{leadId} {
      allow create: if isValidPublicSubmission();
      allow read, update, delete: if isAdmin();
    }

    match /testimonials/{testimonialId} {
      allow read: if true;
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.userId;
      allow update, delete: if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin());
    }

    match /videoTestimonials/{testimonialId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /aboutUs/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /blogs/{blogId} {
      // Covers list too: public queries must filter where('status','==','published')
      allow read: if resource.data.status == 'published' || isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || isBlogViewIncrement();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /faqs/{faqId} {
      allow read: if true;
      // Only authenticated brand owners can create FAQs for their own brand
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.userId;
      allow update, delete: if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin());
    }

    // Email logs — only authenticated flows write; admins read
    match /emailLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Location Finder — Saved Locations
    match /savedLocations/{locationId} {
      allow read: if isSignedIn() && request.auth.uid == resource.data.userId;
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.userId;
      allow update, delete: if isSignedIn() && request.auth.uid == resource.data.userId;
    }

    // Location Finder — Search History
    match /searchHistory/{historyId} {
      allow read: if isSignedIn() && request.auth.uid == resource.data.userId;
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.userId;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.userId;
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}